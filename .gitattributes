# Media is stored as ordinary Git objects, NOT Git LFS.
#
# Vercel does not fetch LFS objects during its build: it checks out the
# pointer files and the bundler ships those 131-byte text stubs in place of
# every image and video. Keep media out of LFS unless the deployment target
# is known to run `git lfs pull`.

# Normalise line endings for text, and never touch binaries.
* text=auto

*.png  binary
*.jpg  binary
*.jpeg binary
*.JPG  binary
*.JPEG binary
*.PNG  binary
*.gif  binary
*.webp binary
*.ico  binary
*.svg  text
*.mp4  binary
*.MP4  binary
*.mov  binary
*.webm binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
